# --- Robinhood Chain ---
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_CHAIN_NAME=Robinhood Chain
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com
NEXT_PUBLIC_SITE_URL=

# --- Protocol contracts (filled by `npm run deploy:contracts`, also written to deployments/<chainId>.json) ---
PAYOFF_FACTORY_ADDRESS=
NEXT_PUBLIC_PAYOFF_FACTORY_ADDRESS=
# Block the factory was deployed at: activity logs and vault lookups scan from here.
PAYOFF_FACTORY_START_BLOCK=

# --- Third-party contracts on Robinhood Chain (defaults are the canonical deployments; override only to point elsewhere) ---
# Morpho Blue and its Adaptive Curve IRM: docs.morpho.org/get-started/resources/addresses
MORPHO_ADDRESS=0x9D53d5E3bd5E8d4Cbfa6DB1ca238AEA02E651010
ADAPTIVE_CURVE_IRM=0x2BD3d5965B26B51814AC95127B2b80dD6CcC0fa1
# Uniswap V3: factory, SwapRouter (v1, with deadline), NonfungiblePositionManager, QuoterV2
UNISWAP_V3_FACTORY=0x1f7d7550b1b028f7571e69a784071f0205fd2efa
UNISWAP_V3_SWAP_ROUTER=0xcaf681a66d020601342297493863e78c959e5cb2
UNISWAP_V3_POSITION_MANAGER=0x73991a25C818Bf1f1128dEAaB1492D45638DE0D3
UNISWAP_V3_QUOTER=0x33e885ed0ec9bf04ecfb19341582aadcb4c8a9e7
MULTICALL3_ADDRESS=0xcA11bde05977b3631167028862bE2a173976CA11
# USDG (Global Dollar, 6 decimals): the loan token every market on the board lends
USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168

# --- Deploy (local only; never on Vercel) ---
DEPLOYER_PRIVATE_KEY=
# Receives the protocol's share of harvested fees and performance fees.
TREASURY_ADDRESS=
# Fees in basis points. Vault hard caps: harvest 500, performance 2000.
HARVEST_FEE_BPS=250
PERFORMANCE_FEE_BPS=1000
BLOCKSCOUT_URL=https://robinhoodchain.blockscout.com

# --- Site behaviour ---
RATE_LIMIT_PER_MINUTE=60
TRUST_PROXY=true
# Markets with less USDG available than this are not offered as "best"
MIN_MARKET_LIQUIDITY_USD=100
# Robinhood Chain makes a block every ~100 ms
BLOCKS_PER_DAY=864000
LOG_CHUNK_BLOCKS=100000

# --- Agent brain defaults (lib/services/plan.ts; per-request overrides via /plan query) ---
AGENT_MIN_SAVINGS_BPS=30
AGENT_HARVEST_FLOOR_USD=1
AGENT_MIN_DEPLOY_USD=25
AGENT_RANGE_WIDTH_PCT=5
AGENT_LOSS_LIMIT_PCT=15
AGENT_OUT_OF_RANGE_EXIT=true
# AGENT_PREFERRED_FEE=500

# --- Agent runner (agent/index.mjs, runs on Railway or any always-on box, NOT on Vercel) ---
# PAYOFF_API_URL=https://<your-site>
# AGENT_PRIVATE_KEY=            the OPERATOR key you registered on the vault — never the owner key
# AGENT_VAULTS=                 comma-separated; default: every vault operated by the key
# AGENT_DRY_RUN=true            signs nothing until set to false
# AGENT_TICK_MS=60000
# AGENT_MAX_ACTIONS=3
# AGENT_MIN_ETH=0.0005
# AGENT_PLAN_QUERY=              query appended to /plan, e.g. minDeployUsd=10&rangeWidthPct=3
# AGENT_PLAN_MAX_AGE_S=45        a plan older than this is not acted on
# AGENT_STUCK_MIN=3              replace a pending transaction after this many minutes
# AGENT_REVIEW_TIMEOUT_MS=20000  Claude review timeout; on timeout the plan runs as-is
# HOST=127.0.0.1                 /health and /decisions bind here; set 0.0.0.0 only behind a firewall
# PAYOFF_FACTORY_ADDRESS is also read by the runner to confirm each vault is a real clone
# ANTHROPIC_API_KEY=            optional; Claude may veto an action with a reason, never add one
# AGENT_MODEL=claude-sonnet-5

# --- Demo video (optional): YouTube, Loom, Vimeo or a direct .mp4 URL. Without it the site plays the built-in scripted tour. ---
# NEXT_PUBLIC_DEMO_VIDEO_URL=

# --- Team showcase vaults: owners whose vaults are labelled "team showcase" on the leaderboard (comma-separated). ---
# Run with the team's own funds so visitors can watch the mechanics live; never presented as independent users.
SHOWCASE_OWNERS=
